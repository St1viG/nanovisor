diff --git a/guest/lib/interrupts.c b/guest/lib/interrupts.c
index 80498c5..3aeb039 100644
--- a/guest/lib/interrupts.c
+++ b/guest/lib/interrupts.c
@@ -13,6 +13,7 @@ static struct idt_entry idt[IDT_ENTRIES];
 */
 extern void guest_writer_round(void) __attribute__((weak));
 extern void guest_reader_round(void) __attribute__((weak));
+extern void guest_stop(void) __attribute__((weak));   /* modification C */
 
 /*
 	SSE instrukcije su zabranjene unutar __attribute__((interrupt)) handlera;
@@ -47,6 +48,27 @@ irq32_handler(struct interrupt_frame *frame)
 	}
 }
 
+/*
+	Modification C: vector 33 means "stop". An image may define guest_stop()
+	to close its files and say so; either way the handler returns, the main
+	loop halts again, and the hypervisor terminates the VM on that halt.
+*/
+static void __attribute__((interrupt))
+irq33_handler(struct interrupt_frame *frame)
+{
+	const char *s;
+
+	(void)frame;
+
+	if (guest_stop) {
+		guest_stop();
+		return;
+	}
+
+	for (s = "stopped by vector 33\n"; *s; ++s)
+		outb(PORT_SERIAL, *s);
+}
+
 static void set_idt_gate(unsigned n, void (*handler)(struct interrupt_frame *))
 {
 	uint64_t addr = (uint64_t)(uintptr_t)handler;
@@ -64,6 +86,7 @@ void init_idt(void)
 	struct dt_ptr p;
 
 	set_idt_gate(IRQ_VECTOR, irq32_handler);
+	set_idt_gate(IRQ_VECTOR_STOP, irq33_handler);
 
 	p.limit = sizeof(idt) - 1;
 	p.base  = (uint64_t)(uintptr_t)idt;
