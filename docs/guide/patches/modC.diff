+/*
+	Modification C: after each round the writer reads one byte of standard
+	input. STOP_CHAR makes the hypervisor stop every VM by injecting
+	IRQ_VECTOR_STOP, whose handler is the guest's cue to halt for good.
+*/
+#define IRQ_VECTOR_STOP 33
