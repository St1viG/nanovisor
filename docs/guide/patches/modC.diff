-	interrupt. Returns 1 when the session is over and the VM should halt for
-	real (design D5). This is the only place a VM thread blocks.
+	Blocks this VM's thread until something is due. Returns SB_ROUND when the
+	next vector-32 interrupt should be injected, SB_OVER when the session is
+	over and the VM should halt for real (design D5), and SB_STOPPED when the
+	VM must receive IRQ_VECTOR_STOP and then halt (modification C). This is
+	the only place a VM thread blocks.
 */
+#define SB_ROUND   0
+#define SB_OVER    1
+#define SB_STOPPED 2
 int sb_wait_turn(struct vm *v);
 
+/* Modification C: the writer read STOP_CHAR; wake everyone so they stop. */
+void sb_stop_all(struct vm *v);
