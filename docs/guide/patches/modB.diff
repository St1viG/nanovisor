diff --git a/common/hv_abi.h b/common/hv_abi.h
index 42099dc..7d83068 100644
--- a/common/hv_abi.h
+++ b/common/hv_abi.h
@@ -71,10 +71,17 @@ enum hv_op {
 #define HV_O_WR     2
 #define HV_O_RDWR   4
 #define HV_O_CREATE 8
+/*
+	Modification B. 9 is, as bits, O_RD|O_CREATE, so O_APPEND is recognised by
+	exact match only: the whole flags word must be 9. It opens write-only and
+	every write lands at the current end of the file.
+*/
+#define HV_O_APPEND 9
 
 /* lseek() indicators, spec part B. */
 #define HV_SEEK_SET 1
 #define HV_SEEK_END 2
+#define HV_SEEK_CUR 3   /* modification B: relative to the current position */
 
 /*
 	arg0/arg1/arg2 by operation:
diff --git a/guest/inc/syscall.h b/guest/inc/syscall.h
index c14e88f..2ca41a3 100644
--- a/guest/inc/syscall.h
+++ b/guest/inc/syscall.h
@@ -12,9 +12,11 @@
 #define O_WR     HV_O_WR
 #define O_RDWR   HV_O_RDWR
 #define O_CREATE HV_O_CREATE
+#define O_APPEND HV_O_APPEND
 
 #define SEEK_SET HV_SEEK_SET
 #define SEEK_END HV_SEEK_END
+#define SEEK_CUR HV_SEEK_CUR
 
 /* Signatures exactly as given in the assignment. */
