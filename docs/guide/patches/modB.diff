diff --git a/guest/tests/file_append.c b/guest/tests/file_append.c
new file mode 100644
index 0000000..9a5ab80
--- /dev/null
+++ b/guest/tests/file_append.c
@@ -0,0 +1,69 @@
+#include "guest.h"
+#include "print.h"
+#include "syscall.h"
+
+/*
+	Modification B: SEEK_CUR and O_APPEND. Run with -f shared.txt, where
+	shared.txt contains ORIGINAL, to also see an append on a shared file.
+
+	Expected:
+	  lseek(1, SEEK_SET) -> 1
+	  lseek(1, SEEK_CUR) -> 2
+	  lseek(-5, SEEK_CUR) -> -1          (would land before the start)
+	  open(log.txt, O_APPEND) -> 0
+	  lseek(0, SEEK_SET) -> 0            (accepted, but the next write ignores it)
+	  write(def) -> 3
+	  read on an append fd -> -1         (write-only)
+	  content: abcdef
+	  open(missing.txt, O_APPEND) -> -1  (append does not create)
+	  open(shared.txt, O_APPEND) -> 0
+	  write(+more) -> 5                  (host shared.txt untouched, vm_0/shared.txt = ORIGINAL+more)
+*/
+
+static void show(const char *what, int v)
+{
+	print(what);
+	print(" -> ");
+	if (v < 0) {
+		putch('-');
+		print_dec((uint64_t)(-(long)v));
+	} else {
+		print_dec((uint64_t)v);
+	}
+	print("\n");
+}
+
+void guest_main(void)
+{
+	char buf[16];
+	int fd, n;
+
+	fd = open("log.txt", O_RDWR | O_CREATE);
+	write(fd, "abc", 3);
+	show("lseek(1, SEEK_SET)", lseek(fd, 1, SEEK_SET));
+	show("lseek(1, SEEK_CUR)", lseek(fd, 1, SEEK_CUR));
+	show("lseek(-5, SEEK_CUR)", lseek(fd, -5, SEEK_CUR));
+	close(fd);
+
+	fd = open("log.txt", O_APPEND);
+	show("open(log.txt, O_APPEND)", fd);
+	show("lseek(0, SEEK_SET)", lseek(fd, 0, SEEK_SET));
+	show("write(def)", write(fd, "def", 3));
+	show("read on an append fd", read(fd, buf, 3));
+	close(fd);
+
+	fd = open("log.txt", O_RD);
+	n = read(fd, buf, sizeof(buf) - 1);
+	buf[n < 0 ? 0 : n] = '\0';
+	print("content: ");
+	print(buf);
+	print("\n");
+	close(fd);
+
+	show("open(missing.txt, O_APPEND)", open("missing.txt", O_APPEND));
+
+	fd = open("shared.txt", O_APPEND);
+	show("open(shared.txt, O_APPEND)", fd);
+	show("write(+more)", write(fd, "+more", 5));
+	close(fd);
+}
