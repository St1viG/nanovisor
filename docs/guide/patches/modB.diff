diff --git a/host/inc/fileio.h b/host/inc/fileio.h
index 15952c0..dc3c26e 100644
--- a/host/inc/fileio.h
+++ b/host/inc/fileio.h
@@ -29,6 +29,7 @@ struct guest_file {
 	int  flags;                      /* spec flags, as passed to open() */
 	int  shared;                     /* came from the -f registry */
 	int  cow;                        /* a VM-local copy has been materialized */
+	int  append;                     /* modification B: every write goes to the current end */
 };
 
 /* Registry of files shared between VMs, from -f/--file. Read-only after setup. */
diff --git a/host/src/fileio.c b/host/src/fileio.c
index 300317d..878414d 100644
--- a/host/src/fileio.c
+++ b/host/src/fileio.c
@@ -190,12 +190,21 @@ static int32_t hv_open(struct vm *v, uint32_t path_gva, int32_t flags)
 	const char *name = guest_str(v, path_gva, GUEST_NAME_MAX);
 	const char *shared;
 	struct guest_file *f;
-	int posix_flags, fd, hostfd;
+	int posix_flags, fd, hostfd, append;
 	char path[HOST_PATH_MAX];
 
 	if (!name || !is_valid_name(name))
 		return -1;
 
+	/*
+		Modification B: O_APPEND is an exact-match flag (see hv_abi.h). From here
+		on it is an ordinary write-only open; the append behaviour lives in
+		hv_write.
+	*/
+	append = (flags == HV_O_APPEND);
+	if (append)
+		flags = HV_O_WR;
+
 	if (to_posix_flags(flags, &posix_flags) < 0)
 		return -1;
 
@@ -241,6 +250,7 @@ static int32_t hv_open(struct vm *v, uint32_t path_gva, int32_t flags)
 	f->flags  = flags;
 	f->shared = shared != NULL;
 	f->cow    = 0;
+	f->append = append;
 
 	return fd;
 }
@@ -400,6 +410,19 @@ static int32_t hv_write(struct vm *v, int32_t fd, uint32_t buf_gva, uint32_t cou
 	if (f->shared && !f->cow && cow_materialize(v, f) < 0)
 		return -1;
 
+	/*
+		Modification B: an append descriptor writes at the current end of the
+		file whatever the offset says. Measured after the CoW step, so it is the
+		private copy that grows.
+	*/
+	if (f->append) {
+		struct stat st;
+
+		if (fstat(f->hostfd, &st) < 0)
+			return -1;
+		f->off = (long)st.st_size;
+	}
+
 	n = pwrite(f->hostfd, buf, count, (off_t)f->off);
 	if (n < 0)
 		return -1;
@@ -429,6 +452,12 @@ static int32_t hv_lseek(struct vm *v, int32_t fd, int32_t offset, int32_t whence
 			return -1;
 		f->off = (long)st.st_size;
 		break;
+	case HV_SEEK_CUR:
+		/* Modification B: relative to the current position, never before the start. */
+		if (f->off + offset < 0)
+			return -1;
+		f->off += offset;
+		break;
 	default:
 		return -1;
 	}
diff --git a/scripts/test_phase_b.sh b/scripts/test_phase_b.sh
index 9342a1c..2901e4a 100755
--- a/scripts/test_phase_b.sh
+++ b/scripts/test_phase_b.sh
@@ -118,6 +118,25 @@ grep -q 'survived' <<<"$out" \
 grep -q 'file request at out-of-range address' <<<"$out" \
 	&& ok "out-of-range request address reported" || bad "no report for a bad request address"
 
+echo
+echo "8. SEEK_CUR and O_APPEND (modification B)"
+rm -rf vm_0
+printf 'ORIGINAL' > shared.txt
+out="$(run -m 4 -p 2 -g $IMG/file_append.img -f shared.txt)"
+grep -q '^\[vm 0\] lseek(1, SEEK_CUR) -> 2$' <<<"$out" \
+	&& ok "SEEK_CUR moves relative to the current position" || bad "SEEK_CUR wrong" "$out"
+grep -q '^\[vm 0\] lseek(-5, SEEK_CUR) -> -1$' <<<"$out" \
+	&& ok "SEEK_CUR before the start is refused" || bad "negative SEEK_CUR accepted" "$out"
+grep -q '^\[vm 0\] content: abcdef$' <<<"$out" \
+	&& ok "O_APPEND writes land at the end despite a seek" || bad "append content wrong" "$out"
+grep -q '^\[vm 0\] read on an append fd -> -1$' <<<"$out" \
+	&& ok "O_APPEND descriptors are write-only" || bad "append fd readable" "$out"
+grep -q '^\[vm 0\] open(missing.txt, O_APPEND) -> -1$' <<<"$out" \
+	&& ok "O_APPEND does not create a missing file" || bad "append created a file" "$out"
+[ "$(cat shared.txt)" = "ORIGINAL" ] && [ "$(cat vm_0/shared.txt 2>/dev/null)" = "ORIGINAL+more" ] \
+	&& ok "appending to a shared file grows the private copy only" || bad "shared append: '$(cat vm_0/shared.txt 2>/dev/null)'"
+rm -f shared.txt
+
 rm -f shared.txt.orig
 
 echo
